@model BookFormViewModel
@{
    ViewData["Title"] = "Add book";
}
<a class="back-link" asp-action="Index">Back to books</a>
<div class="page-heading"><div><h1>Add book</h1><p class="page-description">Enter the book details. Title and ISBN are required.</p></div></div>
<form asp-action="Create" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" class="editor-form">
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn-primary" data-submitting-text="Adding book…">Add book</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
