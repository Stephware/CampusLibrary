@model BookFormViewModel
@{
    ViewData["Title"] = "Edit book";
}
<a class="back-link" asp-action="Index">Back to books</a>
<div class="page-heading"><div><h1>Edit book</h1><p class="page-description">Update the catalog details. Existing loan history will be kept.</p></div></div>
<form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" class="editor-form">
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn-primary" data-submitting-text="Saving changes…">Save changes</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
