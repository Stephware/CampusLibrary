@model BookFormViewModel
<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
<div class="mb-4">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" maxlength="200" aria-describedby="Title-error" required />
    <span asp-validation-for="Title" id="Title-error" class="field-error"></span>
</div>
<div class="mb-4">
    <label asp-for="Isbn" class="form-label"></label>
    <input asp-for="Isbn" class="form-control" maxlength="20" aria-describedby="isbn-help Isbn-error" required />
    <div id="isbn-help" class="form-text">Use the book's unique ISBN, up to 20 characters.</div>
    <span asp-validation-for="Isbn" id="Isbn-error" class="field-error"></span>
</div>
<div class="mb-4">
    <label asp-for="Author" class="form-label"></label> <span class="optional-label">Optional</span>
    <input asp-for="Author" class="form-control" maxlength="100" aria-describedby="Author-error" />
    <span asp-validation-for="Author" id="Author-error" class="field-error"></span>
</div>
<div class="mb-4 form-year">
    <label asp-for="YearPublished" class="form-label"></label> <span class="optional-label">Optional</span>
    <input asp-for="YearPublished" class="form-control" type="number" min="1" max="9999" inputmode="numeric" aria-describedby="YearPublished-error" />
    <span asp-validation-for="YearPublished" id="YearPublished-error" class="field-error"></span>
</div>
