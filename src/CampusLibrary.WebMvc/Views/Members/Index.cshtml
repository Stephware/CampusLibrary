@model List<MemberViewModel>
@{
    ViewData["Title"] = "Members";
}
<div class="page-heading">
    <div><h1>Members</h1><p class="page-description">Keep your library's member register up to date.</p></div>
    <a class="btn btn-primary" asp-action="Create">Add member</a>
</div>
@if (Model.Count == 0)
{
    <section class="empty-state" aria-labelledby="empty-members">
        <h2 id="empty-members">Register your first member</h2>
        <p>Add a member's name, email and student ID so they can borrow books.</p>
        <a class="btn btn-primary" asp-action="Create">Add your first member</a>
    </section>
}
else
{
    <div class="table-responsive table-surface" role="region" aria-label="Member register" tabindex="0">
        <table class="table align-middle mb-0">
            <caption class="visually-hidden">Registered library members; registration dates in UTC</caption>
            <thead><tr><th scope="col">Name</th><th scope="col">Student ID</th><th scope="col">Email</th><th scope="col">Registered</th></tr></thead>
            <tbody>
                @foreach (var member in Model)
                {
                    <tr><th scope="row">@member.Name</th><td class="identifier" data-label="Student ID">@member.StudentId</td><td class="member-email" data-label="Email">@member.Email</td><td class="date-cell" data-label="Registered"><time datetime="@member.RegisteredDate.ToString("yyyy-MM-dd")">@member.RegisteredDate.ToString("dd MMM yyyy")</time></td></tr>
                }
            </tbody>
        </table>
    </div>
    <p class="list-count">@Model.Count registered @(Model.Count == 1 ? "member" : "members") · Dates shown in UTC</p>
}
